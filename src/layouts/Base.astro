---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Hugo Betelu",
  description = "Designer & journaliste — trail, images, récits.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Hugo Betelu" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Polices auto-hébergées : préchargement des 2 plus critiques -->
    <link rel="preload" href="/fonts/league-gothic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
