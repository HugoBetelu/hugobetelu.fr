---
import Base from "../layouts/Base.astro";
// Projets = contenu géré dans le code (fourni par Hugo), pas dans WordPress.
import projects from "../data/projects.json";
---

<Base>
  <main>
    <!-- Hero -->
    <section class="wrap hero">
      <!-- Portrait : s'affiche dès que /portrait.png existe ; sinon placeholder -->
      <figure class="portrait">
        <img
          class="portrait__img"
          src="/portrait.png"
          alt="Portrait dessiné de Hugo Betelu"
          width="800"
          height="800"
          onerror="this.closest('.portrait').classList.add('portrait--empty'); this.remove();"
        />
        <figcaption class="portrait__ph">portrait à venir</figcaption>
      </figure>

      <p class="intro">
        Depuis 10 ans, je cours sur les sentiers. J'écris des mots et je capture
        des images pour les mettre en récit. Je viens de finir mon premier film{" "}
        <strong>Viva Verdon</strong> qui défend une approche différente du
        territoire en tant que traileur.
      </p>

      <div class="actions">
        <a class="btn btn--solid" href="/contact">contact</a>
        <a class="btn btn--outline" href="https://instagram.com" rel="me">instagram</a>
      </div>
    </section>

    <!-- Projets / Production / Écriture -->
    <section class="wrap projects">
      <h2 class="display section-title">Projets, production, écriture</h2>

      {
        projects.map((project) => (
          <article class="project">
            <p class="project-period display">{project.period}</p>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-body">{project.body}</p>
          </article>
        ))
      }
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: 0.5rem;
  }
  .portrait {
    margin: 0 0 1.75rem;
  }
  .portrait__img {
    width: 100%;
    height: auto;
    display: block;
  }
  .portrait__ph {
    display: none;
  }
  .portrait--empty {
    aspect-ratio: 1 / 1;
    background: #f3f3f3;
    border: 1px dashed #cfcfcf;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .portrait--empty .portrait__ph {
    display: block;
  }
  .intro {
    font-size: 1.2rem;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
  }

  .projects {
    padding-top: 3rem;
  }

  .project {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .project:last-child {
    border-bottom: 0;
  }
  .project-period {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .project-title {
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  .project-body {
    color: #222;
    margin: 0;
  }
</style>
