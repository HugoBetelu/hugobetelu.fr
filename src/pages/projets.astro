---
import Base from "../layouts/Base.astro";

const projets = [
  { title: "Film Viva Verdon", href: "/projets/film-viva-verdon", cta: "voir plus" },
  { title: "Magazine Viva Verdon", href: "/projets/magazine-viva-verdon", cta: "lire plus" },
];
---

<Base
  title="Projets — Hugo Betelu"
  description="Les projets de Hugo Betelu : le film et le magazine Viva Verdon."
>
  <main class="wrap projets">
    <h1 class="display section-title">Projets</h1>

    <section class="proj-group">
      <h2 class="display group-title">Récents</h2>

      {projets.map((p) => (
        <article class="proj-item">
          <h3 class="proj-item-title">{p.title}</h3>
          <a class="btn btn--solid" href={p.href}>{p.cta}</a>
        </article>
      ))}
    </section>
  </main>
</Base>

<style>
  .projets {
    padding-block: 1rem 4rem;
  }
  .group-title {
    font-size: 1.7rem;
    margin: 2.5rem 0 0.5rem;
  }
  .proj-item {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .proj-item-title {
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.2;
    margin: 0;
  }
</style>
